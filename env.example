# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Mailchimp Configuration
VITE_MAILCHIMP_URL=https://your-domain.us1.list-manage.com/subscribe/post
VITE_MAILCHIMP_U=your_unique_account_id
VITE_MAILCHIMP_ID=your_audience_list_id

# PayPal Configuration
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# CMS
# Localhost falls back to username "admin" and password "canopy-admin" only when these are unset.
# The live site ignores those defaults. Set all three to long random values before deploy.
CMS_ADMIN_USERNAME=choose-a-username
CMS_ADMIN_PASSWORD=choose-a-long-random-password
CMS_SECRET=choose-a-different-long-random-string

# Production saves commit content and uploads back to GitHub, which redeploys the site.
GITHUB_TOKEN=github_personal_access_token_with_contents_write
GITHUB_REPO=siddhartha008/canopy-website
GITHUB_BRANCH=main 